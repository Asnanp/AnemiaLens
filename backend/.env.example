# Copy this to .env and fill in your values

# Hugging Face API key for Qwen guidance
ANEMIALENS_HF_API_KEY=hf_your_key_here

# Qwen model (default works fine)
ANEMIALENS_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# HF inference provider
ANEMIALENS_HF_PROVIDER=together

# Enable Qwen guidance (true/false)
ANEMIALENS_QWEN_ENABLED=true

# Flask debug mode (never true in production)
FLASK_DEBUG=false
